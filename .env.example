# Copy to .env (never commit .env) and fill in values.
# Generate a JWT secret with:  openssl rand -hex 32
JWT_SECRET=change-me

# Browser-facing API URL, baked into the frontend at build time
VITE_API_URL=http://localhost:5000

# EmailJS (contact form). These end up in the public JS bundle by design.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=
