+apiVersion: v1
+kind: Service
+metadata:
+  name: jobtracker-client
+  namespace: jobtracker
+  annotations:
+    alb.ingress.kubernetes.io/healthcheck-path: /
+spec:
+  type: ClusterIP
+  selector:
+    app: jobtracker-client
+  ports:
+    - port: 80
+      targetPort: 8080
