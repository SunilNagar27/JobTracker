index 0000000..9cd97d1
--- /dev/null
+++ b/k8s/client.yaml
@@ -0,0 +1,65 @@
+# ${CLIENT_IMAGE} is filled in by the Jenkins pipeline (envsubst).
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: jobtracker-client
+  namespace: jobtracker
+  labels:
+    app: jobtracker-client
+spec:
+  replicas: 2
+  selector:
+    matchLabels:
+      app: jobtracker-client
+  template:
+    metadata:
+      labels:
+        app: jobtracker-client
+    spec:
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 101 # the "nginx" user in nginx-unprivileged
+      containers:
+        - name: client
