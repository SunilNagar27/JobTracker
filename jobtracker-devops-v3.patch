diff --git a/jenkins/Dockerfile b/jenkins/Dockerfile
new file mode 100644
index 0000000..eb04681
--- /dev/null
+++ b/jenkins/Dockerfile
@@ -0,0 +1,54 @@
+# Jenkins with every tool the JobTracker pipeline needs baked in:
+# docker CLI, node, aws CLI, kubectl, trivy, gitleaks, sonar-scanner, envsubst.
+FROM jenkins/jenkins:lts-jdk17
+
+USER root
+
+ARG GITLEAKS_VERSION=8.21.2
+ARG SONAR_SCANNER_VERSION=6.2.1.4610
+
+RUN apt-get update && apt-get install -y --no-install-recommends \
+      curl unzip gnupg ca-certificates gettext-base jq git \
+    && rm -rf /var/lib/apt/lists/*
+
+# Node.js 20
+RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
+    && apt-get install -y --no-install-recommends nodejs \
+    && rm -rf /var/lib/apt/lists/*
+
+# Docker CLI only (the daemon is the host's, via the mounted socket)
+RUN install -m 0755 -d /etc/apt/keyrings \
+    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
+    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
+       > /etc/apt/sources.list.d/docker.list \
+    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
+    && rm -rf /var/lib/apt/lists/*
+
+# AWS CLI v2 (uname -m is x86_64 or aarch64, which matches AWS's file names)
+RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscli.zip \
+    && unzip -q /tmp/awscli.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscli.zip
+
+# kubectl, latest 1.35.x to match the EKS version (kubectl may differ by one minor version)
+RUN ARCH=$(dpkg --print-architecture) \
+    && KVER=$(curl -fsSL https://dl.k8s.io/release/stable-1.35.txt) \
+    && curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${KVER}/bin/linux/${ARCH}/kubectl" \
+    && chmod +x /usr/local/bin/kubectl
+
+# Trivy (vulnerability scanner)
+RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
+    | sh -s -- -b /usr/local/bin
+
+# Gitleaks (secret scanner)
+RUN case "$(dpkg --print-architecture)" in amd64) GA=x64 ;; arm64) GA=arm64 ;; esac \
+    && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GA}.tar.gz" \
+    | tar -xz -C /usr/local/bin gitleaks
+
+# SonarScanner CLI (platform-independent zip; uses the JDK 17 already in this image)
+RUN curl -fsSL "https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-${SONAR_SCANNER_VERSION}.zip" -o /tmp/sonar.zip \
+    && unzip -q /tmp/sonar.zip -d /opt && rm /tmp/sonar.zip \
+    && ln -s /opt/sonar-scanner-${SONAR_SCANNER_VERSION}/bin/sonar-scanner /usr/local/bin/sonar-scanner
+
+USER jenkins
+
+COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
+RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt
diff --git a/jenkins/docker-compose.yml b/jenkins/docker-compose.yml
new file mode 100644
index 0000000..518c67c
--- /dev/null
+++ b/jenkins/docker-compose.yml
@@ -0,0 +1,67 @@
+# Local CI toolbox: Jenkins + SonarQube. Costs $0 (runs on your machine).
+#   docker compose up -d --build
+#   Jenkins   -> http://localhost:8080
+#   SonarQube -> http://localhost:9000   (login admin / admin, you will be asked to change it)
+#
+# Linux only, SonarQube needs this once per boot:
+#   sudo sysctl -w vm.max_map_count=262144
+services:
+  jenkins:
+    build: .
+    container_name: jenkins
+    restart: unless-stopped
+    # Root so Jenkins can use the mounted Docker socket. Fine for a local learning
+    # box; do NOT expose this Jenkins to the internet.
+    user: root
+    ports:
+      - "8080:8080"
+    environment:
+      SONAR_HOST_URL: http://sonarqube:9000
+    volumes:
+      - jenkins_home:/var/jenkins_home
+      - /var/run/docker.sock:/var/run/docker.sock
+    networks:
+      - ci
+
+  sonarqube:
+    image: sonarqube:community
+    container_name: sonarqube
+    restart: unless-stopped
+    depends_on:
+      - sonar-db
+    ports:
+      - "9000:9000"
+    environment:
+      SONAR_JDBC_URL: jdbc:postgresql://sonar-db:5432/sonar
+      SONAR_JDBC_USERNAME: sonar
+      SONAR_JDBC_PASSWORD: sonar
+      SONAR_ES_BOOTSTRAP_CHECKS_DISABLE: "true"
+    volumes:
+      - sonar_data:/opt/sonarqube/data
+      - sonar_extensions:/opt/sonarqube/extensions
+      - sonar_logs:/opt/sonarqube/logs
+    networks:
+      - ci
+
+  sonar-db:
+    image: postgres:16-alpine
+    container_name: sonar-db
+    restart: unless-stopped
+    environment:
+      POSTGRES_USER: sonar
+      POSTGRES_PASSWORD: sonar
+      POSTGRES_DB: sonar
+    volumes:
+      - sonar_db:/var/lib/postgresql/data
+    networks:
+      - ci
+
+networks:
+  ci:
+
+volumes:
+  jenkins_home:
+  sonar_data:
+  sonar_extensions:
+  sonar_logs:
+  sonar_db:
